<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cristian_Berrezueta_Examen.ResumenPage"
             Title="Resumen">

    <VerticalStackLayout Padding="30" Spacing="10">
        <Label x:Name="lblTopUsuario" HorizontalOptions="End"/>
        <Label Text="RESUMEN" FontSize="18" HorizontalOptions="Center" FontAttributes="Bold" Margin="0,0,0,20"/>

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="15">
            <Label Grid.Row="0" Grid.Column="0" Text="Nombre"/>
            <Label Grid.Row="0" Grid.Column="1" x:Name="lblNombre"/>

            <Label Grid.Row="1" Grid.Column="0" Text="Apellido"/>
            <Label Grid.Row="1" Grid.Column="1" x:Name="lblApellido"/>

            <Label Grid.Row="2" Grid.Column="0" Text="Edad"/>
            <Label Grid.Row="2" Grid.Column="1" x:Name="lblEdad"/>

            <Label Grid.Row="3" Grid.Column="0" Text="Fecha"/>
            <Label Grid.Row="3" Grid.Column="1" x:Name="lblFecha"/>

            <Label Grid.Row="4" Grid.Column="0" Text="Ciudad"/>
            <Label Grid.Row="4" Grid.Column="1" x:Name="lblCiudad"/>

            <Label Grid.Row="5" Grid.Column="0" Text="País"/>
            <Label Grid.Row="5" Grid.Column="1" x:Name="lblPais"/>

            <Label Grid.Row="6" Grid.Column="0" Text="Monto Inicial"/>
            <Label Grid.Row="6" Grid.Column="1" x:Name="lblMonto"/>

            <Label Grid.Row="7" Grid.Column="0" Text="Pago mensual"/>
            <Label Grid.Row="7" Grid.Column="1" x:Name="lblMensual"/>

            <Label Grid.Row="8" Grid.Column="0" Text="Pago Total"/>
            <Label Grid.Row="8" Grid.Column="1" x:Name="lblTotal"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>